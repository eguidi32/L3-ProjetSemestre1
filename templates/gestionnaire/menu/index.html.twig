{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Gestion des Menus - Brasil Burger{% endblock %}

{% block page_title %}Gestion des Menus{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-primary fs-6">{{ menus|length }} menu(s)</span>
    </div>
    <a href="{{ path('app_gestionnaire_menu_new') }}" class="btn btn-success">
        <i class="bi bi-plus-circle me-2"></i>Nouveau Menu
    </a>
</div>

<div class="card">
    <div class="card-body">
        {% if menus|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;">Image</th>
                        <th>Nom</th>
                        <th>Composition</th>
                        <th>Prix Total</th>
                        <th>État</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for menu in menus %}
                    <tr class="{{ menu.archive ? 'table-secondary' : '' }}">
                        <td>
                            {% if menu.image %}
                            <img src="{{ menu.image }}" alt="{{ menu.nom }}" 
                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px;">
                            {% else %}
                            <div style="width: 60px; height: 60px; background: #eee; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            
                            </div>
                            {% endif %}
                        </td>
                        <td><strong>{{ menu.nom }}</strong></td>
                        <td>
                            <small>
                                {{ menu.burger ? menu.burger.nom : 'N/A' }}<br>
                                {{ menu.boisson ? menu.boisson.nom : 'N/A' }}<br>
                                {{ menu.frites ? menu.frites.nom : 'N/A' }}
                            </small>
                        </td>
                        <td>
                            <strong class="text-warning">{{ menu.prix|number_format(0, ',', ' ') }} F</strong>
                        </td>
                        <td>
                            {% if menu.archive %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_gestionnaire_menu_show', {id: menu.id}) }}" 
                                   class="btn btn-sm btn-outline-info" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_gestionnaire_menu_edit', {id: menu.id}) }}" 
                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('app_gestionnaire_menu_archive', {id: menu.id}) }}" 
                                      method="post" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ menu.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-{{ menu.archive ? 'success' : 'danger' }}" 
                                            title="{{ menu.archive ? 'Restaurer' : 'Archiver' }}">
                                        <i class="bi bi-{{ menu.archive ? 'arrow-counterclockwise' : 'archive' }}"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Aucun menu</h4>
            <p>Commencez par créer votre premier menu</p>
            <a href="{{ path('app_gestionnaire_menu_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Créer un menu
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}