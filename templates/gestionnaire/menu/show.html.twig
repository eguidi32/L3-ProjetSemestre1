{% extends 'gestionnaire/base.html.twig' %}

{% block title %}{{ menu.nom }} - Brasil Burger{% endblock %}

{% block page_title %}Détails du Menu{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-5">
                        {% if menu.image %}
                        <img src="{{ menu.image }}" alt="{{ menu.nom }}" 
                             class="img-fluid rounded" style="width: 100%;">
                        {% else %}
                        <div class="bg-light d-flex align-items-center justify-content-center rounded" 
                             style="height: 300px; font-size: 5rem;">
                        </div>
                        {% endif %}
                    </div>
                    <div class="col-md-7">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="mb-0">{{ menu.nom }}</h2>
                            {% if menu.archive %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </div>

                        <h3 class="text-warning mb-4">{{ menu.prix|number_format(0, ',', ' ') }} FCFA</h3>

                        {% if menu.description %}
                        <div class="mb-3">
                            <h6 class="text-muted">Description</h6>
                            <p>{{ menu.description }}</p>
                        </div>
                        {% endif %}

                        <div class="card bg-light mb-4">
                            <div class="card-header">
                                <strong>Composition du menu</strong>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 text-center">
                                        {% if menu.burger and menu.burger.image %}
                                        <img src="{{ menu.burger.image }}" alt="{{ menu.burger.nom }}" 
                                             style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px;" class="mb-2">
                                        {% else %}
                                        <div class="mb-2" style="font-size: 3rem;"></div>
                                        {% endif %}
                                        <h6>{{ menu.burger ? menu.burger.nom : 'N/A' }}</h6>
                                        <small class="text-muted">{{ menu.burger ? menu.burger.prix|number_format(0, ',', ' ') ~ ' F' : '' }}</small>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        {% if menu.boisson and menu.boisson.image %}
                                        <img src="{{ menu.boisson.image }}" alt="{{ menu.boisson.nom }}" 
                                             style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px;" class="mb-2">
                                        {% else %}
                                        <div class="mb-2" style="font-size: 3rem;"></div>
                                        {% endif %}
                                        <h6>{{ menu.boisson ? menu.boisson.nom : 'N/A' }}</h6>
                                        <small class="text-muted">{{ menu.boisson ? menu.boisson.prix|number_format(0, ',', ' ') ~ ' F' : '' }}</small>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        {% if menu.frites and menu.frites.image %}
                                        <img src="{{ menu.frites.image }}" alt="{{ menu.frites.nom }}" 
                                             style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px;" class="mb-2">
                                        {% else %}
                                        <div class="mb-2" style="font-size: 3rem;"></div>
                                        {% endif %}
                                        <h6>{{ menu.frites ? menu.frites.nom : 'N/A' }}</h6>
                                        <small class="text-muted">{{ menu.frites ? menu.frites.prix|number_format(0, ',', ' ') ~ ' F' : '' }}</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <small class="text-muted">
                                <i class="bi bi-calendar me-1"></i>
                                Créé le {{ menu.dateCreation|date('d/m/Y à H:i') }}
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_gestionnaire_menu_edit', {id: menu.id}) }}" 
                               class="btn btn-warning">
                                <i class="bi bi-pencil me-2"></i>Modifier
                            </a>
                            <form action="{{ path('app_gestionnaire_menu_archive', {id: menu.id}) }}" 
                                  method="post" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ menu.id) }}">
                                <button type="submit" class="btn btn-{{ menu.archive ? 'success' : 'danger' }}">
                                    <i class="bi bi-{{ menu.archive ? 'arrow-counterclockwise' : 'archive' }} me-2"></i>
                                    {{ menu.archive ? 'Restaurer' : 'Archiver' }}
                                </button>
                            </form>
                            <a href="{{ path('app_gestionnaire_menus') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Retour
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}