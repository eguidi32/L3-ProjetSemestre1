{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Modifier {{ menu.nom }} - Brasil Burger{% endblock %}

{% block page_title %}Modifier le Menu{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Modifier : {{ menu.nom }}</h5>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                
                <div class="mb-3">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="card bg-light mb-3">
                    <div class="card-header">
                        <strong>🍽️ Composition du menu</strong>
                        <small class="text-muted">(Prix actuel: {{ menu.prix|number_format(0, ',', ' ') }} F)</small>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.burger) }}
                                {{ form_widget(form.burger) }}
                                {{ form_errors(form.burger) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.boisson) }}
                                {{ form_widget(form.boisson) }}
                                {{ form_errors(form.boisson) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.frites) }}
                                {{ form_widget(form.frites) }}
                                {{ form_errors(form.frites) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Image actuelle</label>
                    {% if menu.image %}
                    <div class="mb-2">
                        <img src="{{ menu.image }}" alt="{{ menu.nom }}" 
                             style="max-width: 200px; border-radius: 10px;">
                    </div>
                    {% endif %}
                    {{ form_label(form.imageFile, 'Nouvelle image (optionnel)') }}
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                    <small class="text-muted">Laissez vide pour conserver l'image actuelle</small>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_gestionnaire_menus') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Annuler
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}