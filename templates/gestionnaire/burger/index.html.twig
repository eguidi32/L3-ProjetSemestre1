{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Gestion des Burgers - Brasil Burger{% endblock %}

{% block page_title %}Gestion des Burgers{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-primary fs-6">{{ burgers|length }} burger(s)</span>
    </div>
    <a href="{{ path('app_gestionnaire_burger_new') }}" class="btn btn-success">
        <i class="bi bi-plus-circle me-2"></i>Nouveau Burger
    </a>
</div>

<div class="card">
    <div class="card-body">
        {% if burgers|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;">Image</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Description</th>
                        <th>État</th>
                        <th>Date création</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for burger in burgers %}
                    <tr class="{{ burger.archive ? 'table-secondary' : '' }}">
                        <td>
                            {% if burger.image %}
                            <img src="{{ burger.image }}" alt="{{ burger.nom }}" 
                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px;">
                            {% else %}
                            <div style="width: 60px; height: 60px; background: #eee; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                
                            </div>
                            {% endif %}
                        </td>
                        <td><strong>{{ burger.nom }}</strong></td>
                        <td>{{ burger.prix|number_format(0, ',', ' ') }} F</td>
                        <td>{{ burger.description|length > 50 ? burger.description|slice(0, 50) ~ '...' : burger.description }}</td>
                        <td>
                            {% if burger.archive %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </td>
                        <td>{{ burger.dateCreation|date('d/m/Y') }}</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_gestionnaire_burger_show', {id: burger.id}) }}" 
                                   class="btn btn-sm btn-outline-info" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_gestionnaire_burger_edit', {id: burger.id}) }}" 
                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('app_gestionnaire_burger_archive', {id: burger.id}) }}" 
                                      method="post" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ burger.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-{{ burger.archive ? 'success' : 'danger' }}" 
                                            title="{{ burger.archive ? 'Restaurer' : 'Archiver' }}">
                                        <i class="bi bi-{{ burger.archive ? 'arrow-counterclockwise' : 'archive' }}"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Aucun burger</h4>
            <p>Commencez par créer votre premier burger</p>
            <a href="{{ path('app_gestionnaire_burger_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Créer un burger
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}