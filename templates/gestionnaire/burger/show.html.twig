{% extends 'gestionnaire/base.html.twig' %}

{% block title %}{{ burger.nom }} - Brasil Burger{% endblock %}

{% block page_title %}Détails du Burger{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-5">
                        {% if burger.image %}
                        <img src="{{ burger.image }}" alt="{{ burger.nom }}" 
                             class="img-fluid rounded" style="width: 100%;">
                        {% else %}
                        <div class="bg-light d-flex align-items-center justify-content-center rounded" 
                             style="height: 300px; font-size: 5rem;">
                        </div>
                        {% endif %}
                    </div>
                    <div class="col-md-7">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="mb-0">{{ burger.nom }}</h2>
                            {% if burger.archive %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </div>

                        <h3 class="text-warning mb-4">{{ burger.prix|number_format(0, ',', ' ') }} FCFA</h3>

                        {% if burger.description %}
                        <div class="mb-3">
                            <h6 class="text-muted">Description</h6>
                            <p>{{ burger.description }}</p>
                        </div>
                        {% endif %}

                        {% if burger.ingredients %}
                        <div class="mb-3">
                            <h6 class="text-muted">Ingrédients</h6>
                            <p>{{ burger.ingredients }}</p>
                        </div>
                        {% endif %}

                        <div class="mb-4">
                            <small class="text-muted">
                                <i class="bi bi-calendar me-1"></i>
                                Créé le {{ burger.dateCreation|date('d/m/Y à H:i') }}
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_gestionnaire_burger_edit', {id: burger.id}) }}" 
                               class="btn btn-warning">
                                <i class="bi bi-pencil me-2"></i>Modifier
                            </a>
                            <form action="{{ path('app_gestionnaire_burger_archive', {id: burger.id}) }}" 
                                  method="post" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ burger.id) }}">
                                <button type="submit" class="btn btn-{{ burger.archive ? 'success' : 'danger' }}">
                                    <i class="bi bi-{{ burger.archive ? 'arrow-counterclockwise' : 'archive' }} me-2"></i>
                                    {{ burger.archive ? 'Restaurer' : 'Archiver' }}
                                </button>
                            </form>
                            <a href="{{ path('app_gestionnaire_burgers') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Retour
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}