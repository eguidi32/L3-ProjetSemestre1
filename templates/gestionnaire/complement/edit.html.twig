{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Modifier {{ complement.nom }} - Brasil Burger{% endblock %}

{% block page_title %}Modifier le Complément{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Modifier : {{ complement.nom }}</h5>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                
                <div class="mb-3">
                    {{ form_label(form.typeComplement) }}
                    {{ form_widget(form.typeComplement) }}
                    {{ form_errors(form.typeComplement) }}
                </div>

                <div class="row">
                    <div class="col-md-7 mb-3">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="col-md-5 mb-3">
                        {{ form_label(form.prix) }}
                        <div class="input-group">
                            {{ form_widget(form.prix) }}
                            <span class="input-group-text">FCFA</span>
                        </div>
                        {{ form_errors(form.prix) }}
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Image actuelle</label>
                    {% if complement.image %}
                    <div class="mb-2">
                        <img src="{{ complement.image }}" alt="{{ complement.nom }}" 
                             style="max-width: 150px; border-radius: 10px;">
                    </div>
                    {% endif %}
                    {{ form_label(form.imageFile, 'Nouvelle image (optionnel)') }}
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                    <small class="text-muted">Laissez vide pour conserver l'image actuelle</small>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_gestionnaire_complements') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Annuler
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}