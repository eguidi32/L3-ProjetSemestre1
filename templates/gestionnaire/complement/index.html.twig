{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Gestion des Compléments - Brasil Burger{% endblock %}

{% block page_title %}Gestion des Compléments{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-info fs-6 me-2">{{ boissons|length }} boisson(s)</span>
        <span class="badge bg-warning fs-6">{{ frites|length }} frites</span>
    </div>
    <a href="{{ path('app_gestionnaire_complement_new') }}" class="btn btn-success">
        <i class="bi bi-plus-circle me-2"></i>Nouveau Complément
    </a>
</div>

<!-- Onglets Boissons / Frites -->
<ul class="nav nav-tabs mb-4" id="complementTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button">
            Tous ({{ complements|length }})
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="boissons-tab" data-bs-toggle="tab" data-bs-target="#boissons" type="button">
            Boissons ({{ boissons|length }})
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="frites-tab" data-bs-toggle="tab" data-bs-target="#frites" type="button">
            Frites ({{ frites|length }})
        </button>
    </li>
</ul>

<div class="tab-content" id="complementTabContent">
    <!-- Tous les compléments -->
    <div class="tab-pane fade show active" id="all" role="tabpanel">
        {{ _self.renderTable(complements) }}
    </div>
    
    <!-- Boissons -->
    <div class="tab-pane fade" id="boissons" role="tabpanel">
        {{ _self.renderTable(boissons) }}
    </div>
    
    <!-- Frites -->
    <div class="tab-pane fade" id="frites" role="tabpanel">
        {{ _self.renderTable(frites) }}
    </div>
</div>

{% macro renderTable(items) %}
<div class="card">
    <div class="card-body">
        {% if items|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;">Image</th>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Prix</th>
                        <th>État</th>
                        <th>Date création</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for complement in items %}
                    <tr class="{{ complement.archive ? 'table-secondary' : '' }}">
                        <td>
                            {% if complement.image %}
                            <img src="{{ complement.image }}" alt="{{ complement.nom }}" 
                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px;">
                            {% else %}
                            <div style="width: 60px; height: 60px; background: #eee; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                {{ complement.typeComplement == 'BOISSON' ? ' ' : ' ' }}
                            </div>
                            {% endif %}
                        </td>
                        <td><strong>{{ complement.nom }}</strong></td>
                        <td>
                            {% if complement.typeComplement == 'BOISSON' %}
                                <span class="badge bg-info">Boisson</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">Frites</span>
                            {% endif %}
                        </td>
                        <td>{{ complement.prix|number_format(0, ',', ' ') }} F</td>
                        <td>
                            {% if complement.archive %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </td>
                        <td>{{ complement.dateCreation|date('d/m/Y') }}</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_gestionnaire_complement_show', {id: complement.id}) }}" 
                                   class="btn btn-sm btn-outline-info" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_gestionnaire_complement_edit', {id: complement.id}) }}" 
                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('app_gestionnaire_complement_archive', {id: complement.id}) }}" 
                                      method="post" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ complement.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-{{ complement.archive ? 'success' : 'danger' }}" 
                                            title="{{ complement.archive ? 'Restaurer' : 'Archiver' }}">
                                        <i class="bi bi-{{ complement.archive ? 'arrow-counterclockwise' : 'archive' }}"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Aucun complément</h4>
            <p>Commencez par créer votre premier complément</p>
            <a href="{{ path('app_gestionnaire_complement_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Créer un complément
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endmacro %}
{% endblock %}