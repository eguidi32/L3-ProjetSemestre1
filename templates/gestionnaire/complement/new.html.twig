{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Nouveau Complément - Brasil Burger{% endblock %}

{% block page_title %}Nouveau Complément{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Créer un nouveau complément</h5>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                
                <div class="mb-3">
                    {{ form_label(form.typeComplement) }}
                    {{ form_widget(form.typeComplement) }}
                    {{ form_errors(form.typeComplement) }}
                </div>

                <div class="row">
                    <div class="col-md-7 mb-3">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="col-md-5 mb-3">
                        {{ form_label(form.prix) }}
                        <div class="input-group">
                            {{ form_widget(form.prix) }}
                            <span class="input-group-text">FCFA</span>
                        </div>
                        {{ form_errors(form.prix) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.imageFile) }}
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                    <small class="text-muted">Formats acceptés : JPEG, PNG, WebP, GIF. Taille max : 5 Mo</small>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_gestionnaire_complements') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Annuler
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-2"></i>Créer le complément
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}