{% extends 'gestionnaire/base.html.twig' %}

{% block title %}{{ complement.nom }} - Brasil Burger{% endblock %}

{% block page_title %}Détails du Complément{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body text-center">
                {% if complement.image %}
                <img src="{{ complement.image }}" alt="{{ complement.nom }}" 
                     class="img-fluid rounded mb-4" style="max-height: 250px;">
                {% else %}
                <div class="bg-light d-flex align-items-center justify-content-center rounded mb-4 mx-auto" 
                     style="height: 200px; width: 200px; font-size: 5rem;">
                    {{ complement.typeComplement == 'BOISSON' ? ' ' : ' ' }}
                </div>
                {% endif %}

                <div class="d-flex justify-content-center gap-2 mb-3">
                    {% if complement.typeComplement == 'BOISSON' %}
                        <span class="badge bg-info fs-6">Boisson</span>
                    {% else %}
                        <span class="badge bg-warning text-dark fs-6">Frites</span>
                    {% endif %}
                    
                    {% if complement.archive %}
                        <span class="badge bg-secondary fs-6">Archivé</span>
                    {% else %}
                        <span class="badge bg-success fs-6">Actif</span>
                    {% endif %}
                </div>

                <h2>{{ complement.nom }}</h2>
                <h3 class="text-warning mb-4">{{ complement.prix|number_format(0, ',', ' ') }} FCFA</h3>

                <div class="mb-4">
                    <small class="text-muted">
                        <i class="bi bi-calendar me-1"></i>
                        Créé le {{ complement.dateCreation|date('d/m/Y à H:i') }}
                    </small>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a href="{{ path('app_gestionnaire_complement_edit', {id: complement.id}) }}" 
                       class="btn btn-warning">
                        <i class="bi bi-pencil me-2"></i>Modifier
                    </a>
                    <form action="{{ path('app_gestionnaire_complement_archive', {id: complement.id}) }}" 
                          method="post" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ complement.id) }}">
                        <button type="submit" class="btn btn-{{ complement.archive ? 'success' : 'danger' }}">
                            <i class="bi bi-{{ complement.archive ? 'arrow-counterclockwise' : 'archive' }} me-2"></i>
                            {{ complement.archive ? 'Restaurer' : 'Archiver' }}
                        </button>
                    </form>
                    <a href="{{ path('app_gestionnaire_complements') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}