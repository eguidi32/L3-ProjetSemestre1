{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Gestion des Livraisons - Brasil Burger{% endblock %}

{% block page_title %}Gestion des Livraisons{% endblock %}
{% block page_subtitle %}Affectez les livreurs et suivez les livraisons{% endblock %}
{% block page_icon %}<i class="bi bi-truck"></i>{% endblock %}

{% block body %}
<div class="row">
    <!-- Commandes à affecter par zone -->
    <div class="col-lg-8">
        <div class="card mb-4 fade-in-up">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>Commandes à affecter par zone</span>
                </div>
                <span class="pending-badge">
                    <i class="bi bi-hourglass-split"></i>
                    {{ totalNonAffectees }} en attente
                </span>
            </div>
            <div class="card-body">
                {% if commandesParZone|length > 0 %}
                <form action="{{ path('app_gestionnaire_livraison_affecter') }}" method="post" id="formAffectation">
                    <input type="hidden" name="_token" value="{{ csrf_token('affecter_livreur') }}">
                    
                    <!-- Sélection du livreur -->
                    <div class="affectation-box mb-4">
                        <div class="row align-items-end">
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-person-badge me-1"></i>
                                    <strong>Sélectionner un livreur</strong>
                                </label>
                                <select name="livreur" class="form-select" required>
                                    <option value="">-- Choisir un livreur --</option>
                                    {% for livreur in livreurs %}
                                    <option value="{{ livreur.id }}">
                                        {{ livreur.nomComplet }} ({{ livreur.telephone }})
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 mt-3 mt-md-0">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-person-plus me-2"></i>Affecter les commandes sélectionnées
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Commandes groupées par zone -->
                    <div class="accordion" id="accordionZones">
                        {% for zoneId, data in commandesParZone %}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button {{ loop.first ? '' : 'collapsed' }}" type="button" 
                                        data-bs-toggle="collapse" data-bs-target="#zone{{ zoneId }}">
                                    <span class="zone-name">{{ data.nom }}</span>
                                    <span class="badge bg-primary ms-2">{{ data.commandes|length }} commande(s)</span>
                                    {% if data.zone %}
                                    <span class="badge bg-secondary ms-2">{{ data.zone.prixLivraison|number_format(0, ',', ' ') }} F</span>
                                    {% endif %}
                                </button>
                            </h2>
                            <div id="zone{{ zoneId }}" class="accordion-collapse collapse {{ loop.first ? 'show' : '' }}">
                                <div class="accordion-body p-0">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 40px;">
                                                    <input type="checkbox" class="form-check-input select-all-zone" 
                                                           data-zone="{{ zoneId }}">
                                                </th>
                                                <th>N Commande</th>
                                                <th>Client</th>
                                                <th>Adresse</th>
                                                <th>Montant</th>
                                                <th>Heure</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for commande in data.commandes %}
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="form-check-input commande-checkbox zone-{{ zoneId }}" 
                                                           name="commandes[]" value="{{ commande.id }}">
                                                </td>
                                                <td><strong>{{ commande.numero }}</strong></td>
                                                <td>
                                                    {{ commande.client.nomComplet }}<br>
                                                    <small class="text-muted">{{ commande.client.telephone }}</small>
                                                </td>
                                                <td>
                                                    <small>{{ commande.adresseLivraison ?: 'Non renseignee' }}</small>
                                                </td>
                                                <td>{{ commande.montantTotal|number_format(0, ',', ' ') }} F</td>
                                                <td>{{ commande.dateCommande|date('H:i') }}</td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </form>
                {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle" style="font-size: 4rem;"></i>
                    <h5 class="mt-3">Aucune commande en attente d'affectation</h5>
                    <p>Toutes les livraisons ont été affectées</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Sidebar : Livraisons en cours -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Livraisons en cours</h5>
            </div>
            <div class="card-body p-0">
                {% if commandesEnLivraison|length > 0 %}
                <div class="list-group list-group-flush">
                    {% for commande in commandesEnLivraison %}
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>{{ commande.numero }}</strong><br>
                                <small class="text-muted">
                                    {{ commande.client.nomComplet }}<br>
                                    {{ commande.zone ? commande.zone.nom : 'Zone ?' }}
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info">{{ commande.livreur.nomComplet }}</span>
                                <div class="btn-group btn-group-sm mt-2">
                                    <form action="{{ path('app_gestionnaire_livraison_terminer', {id: commande.id}) }}" 
                                          method="post" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('terminer_livraison' ~ commande.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success" title="Terminer">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <form action="{{ path('app_gestionnaire_livraison_retirer', {id: commande.id}) }}" 
                                          method="post" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('retirer' ~ commande.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Retirer livreur">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                    <p class="mt-2 mb-0">Aucune livraison en cours</p>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Livreurs disponibles -->
        <div class="card mt-4 fade-in-up" style="animation-delay: 0.2s;">
            <div class="card-header">
                <i class="bi bi-people-fill"></i>
                <span>Livreurs disponibles</span>
            </div>
            <div class="card-body p-0">
                {% if livreurs|length > 0 %}
                <ul class="list-group list-group-flush">
                    {% for livreur in livreurs %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="livreur-avatar">
                                {{ livreur.prenom|first|upper }}{{ livreur.nom|first|upper }}
                            </div>
                            <div>
                                <strong>{{ livreur.nomComplet }}</strong><br>
                                <small class="text-muted"><i class="bi bi-phone"></i> {{ livreur.telephone }}</small>
                            </div>
                        </div>
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Disponible</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="empty-state py-4">
                    <i class="bi bi-person-x" style="font-size: 2rem;"></i>
                    <p class="mb-0 mt-2">Aucun livreur disponible</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .pending-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, #FFD700, #e6c200);
        color: #1a1a1a;
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }
    
    .affectation-box {
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), transparent);
        border: 1px solid rgba(255, 215, 0, 0.3);
        border-radius: 12px;
        padding: 20px;
    }
    
    .zone-name {
        color: #1a1a1a;
        font-weight: 600;
    }
    
    .zone-price {
        color: #e6c200;
        font-weight: 600;
    }
    
    .livreur-avatar {
        width: 42px;
        height: 42px;
        background: linear-gradient(135deg, #FFD700, #e6c200);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1a1a1a;
        font-weight: 600;
        font-size: 0.9rem;
    }
    
    .delivery-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
        transition: all 0.3s ease;
    }
    
    .delivery-card:hover {
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }
</style>
{% endblock %}

{% block javascripts %}
<script>
    // Sélection de toutes les commandes d'une zone
    document.querySelectorAll('.select-all-zone').forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            const zoneId = this.dataset.zone;
            const isChecked = this.checked;
            document.querySelectorAll('.zone-' + zoneId).forEach(function(cb) {
                cb.checked = isChecked;
            });
        });
    });
</script>
{% endblock %}