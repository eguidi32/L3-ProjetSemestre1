{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Modifier {{ zone.nom }} - Brasil Burger{% endblock %}

{% block page_title %}Modifier la zone{% endblock %}
{% block page_subtitle %}{{ zone.nom }}{% endblock %}
{% block page_icon %}<i class="bi bi-pencil-square"></i>{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-geo-alt"></i> Informations de la zone
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('app_gestionnaire_zone_edit', {id: zone.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('edit_zone_' ~ zone.id) }}">
                    
                    <div class="mb-3">
                        <label for="nom" class="form-label">Nom de la zone <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nom" name="nom" 
                               value="{{ zone.nom }}" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="prix_livraison" class="form-label">Frais de livraison (F CFA) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="prix_livraison" name="prix_livraison" 
                               value="{{ zone.prixLivraison }}" min="0" step="100" required>
                        <div class="form-text">Mettez 0 pour une livraison gratuite</div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="quartiers" class="form-label">Quartiers couverts <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="quartiers" name="quartiers" rows="4" required>{{ zone.quartiers }}</textarea>
                        <div class="form-text">Liste des quartiers couverts par cette zone</div>
                    </div>
                    
                    <div class="d-flex gap-2 justify-content-end">
                        <a href="{{ path('app_gestionnaire_zones') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Enregistrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
