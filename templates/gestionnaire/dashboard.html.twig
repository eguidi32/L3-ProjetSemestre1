{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Dashboard - Brasil Burger{% endblock %}

{% block page_title %}Dashboard{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <!-- Commandes en cours -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <h3>{{ nbCommandesEnCours }}</h3>
            <p>Commandes en cours</p>
        </div>
    </div>

    <!-- Commandes validées -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h3>{{ nbCommandesValidees }}</h3>
            <p>Commandes validées</p>
        </div>
    </div>

    <!-- Recette journalière -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(243, 156, 18, 0.1); color: #f39c12;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h3>{{ recetteJournaliere|number_format(0, ',', ' ') }} F</h3>
            <p>Recette du jour</p>
        </div>
    </div>

    <!-- Commandes annulées -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="bi bi-x-circle"></i>
            </div>
            <h3>{{ nbCommandesAnnulees }}</h3>
            <p>Commandes annulées</p>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Catalogue -->
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="icon mx-auto" style="background: rgba(243, 156, 18, 0.1); color: #f39c12;">
                
            </div>
            <h3>{{ totalBurgers }}</h3>
            <p>Burgers actifs</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="icon mx-auto" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                
            </div>
            <h3>{{ totalMenus }}</h3>
            <p>Menus actifs</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="icon mx-auto" style="background: rgba(6, 182, 212, 0.1); color: #06b6d4;">
                
            </div>
            <h3>{{ totalComplements }}</h3>
            <p>Compléments actifs</p>
        </div>
    </div>
</div>

<!-- Commandes récentes en cours -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Commandes en cours du jour</h5>
                <a href="{{ path('app_gestionnaire_commandes') }}" class="btn btn-sm btn-outline-primary">Voir tout</a>
            </div>
            <div class="card-body">
                {% if commandesEnCours|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>N° Commande</th>
                                <th>Client</th>
                                <th>Type</th>
                                <th>Montant</th>
                                <th>État</th>
                                <th>Heure</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for commande in commandesEnCours|slice(0, 5) %}
                            <tr>
                                <td><strong>{{ commande.numero }}</strong></td>
                                <td>{{ commande.client.nomComplet }}</td>
                                <td>{{ commande.typeServiceLabel }}</td>
                                <td>{{ commande.montantTotal|number_format(0, ',', ' ') }} F</td>
                                <td><span class="badge {{ commande.etatBadgeClass }}">{{ commande.etatLabel }}</span></td>
                                <td>{{ commande.dateCommande|date('H:i') }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Aucune commande en cours pour aujourd'hui</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}