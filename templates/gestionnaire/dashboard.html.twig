{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Dashboard - Brasil Burger{% endblock %}

{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble et indicateurs de performance{% endblock %}
{% block page_icon %}<i class="bi bi-speedometer2"></i>{% endblock %}

{% block body %}
<!-- Alertes urgentes -->
{% if nbCommandesUrgentes > 0 %}
<div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <div class="flex-grow-1">
            <strong>Attention !</strong> Vous avez <strong>{{ nbCommandesUrgentes }}</strong> commande(s) en attente depuis plus de 30 minutes.
        </div>
        <a href="{{ path('app_gestionnaire_commandes') }}" class="btn btn-sm btn-warning">
            <i class="bi bi-eye me-1"></i>Voir
        </a>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}


<!-- KPIs Principaux -->
<div class="row g-4 mb-4">
    <!-- Recette du jour -->
    <div class="col-md-6 col-xl-3">
        <div class="kpi-card fade-in-up" style="animation-delay: 0.1s;">
            <div class="kpi-header">
                <div class="kpi-icon bg-yellow">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="kpi-trend {% if evolutionRecette >= 0 %}positive{% else %}negative{% endif %}">
                    <i class="bi bi-arrow-{% if evolutionRecette >= 0 %}up{% else %}down{% endif %}"></i>
                    {{ evolutionRecette|abs }}%
                </div>
            </div>
            <div class="kpi-body">
                <h3>{{ recetteJournaliere|number_format(0, ',', ' ') }} <small>FCFA</small></h3>
                <p>Recette du jour</p>
                <div class="kpi-footer">
                    <small class="text-muted">Mois : {{ recetteMois|number_format(0, ',', ' ') }} FCFA</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Commandes du jour -->
    <div class="col-md-6 col-xl-3">
        <div class="kpi-card fade-in-up" style="animation-delay: 0.2s;">
            <div class="kpi-header">
                <div class="kpi-icon bg-black">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="kpi-trend {% if evolutionCommandes >= 0 %}positive{% else %}negative{% endif %}">
                    <i class="bi bi-arrow-{% if evolutionCommandes >= 0 %}up{% else %}down{% endif %}"></i>
                    {{ evolutionCommandes|abs }}%
                </div>
            </div>
            <div class="kpi-body">
                <h3>{{ nbCommandesValidees + nbCommandesEnCours }}</h3>
                <p>Commandes aujourd'hui</p>
                <div class="kpi-footer">
                    <small class="text-muted">Mois : {{ nbCommandesMois }} commandes</small>
                </div>
            </div>
        </div>
    </div>

    <!-- En cours -->
    <div class="col-md-6 col-xl-3">
        <div class="kpi-card fade-in-up" style="animation-delay: 0.3s;">
            <div class="kpi-header">
                <div class="kpi-icon bg-info">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                {% if nbCommandesUrgentes > 0 %}
                <div class="kpi-badge urgent">
                    <i class="bi bi-exclamation-circle"></i> {{ nbCommandesUrgentes }} urgente(s)
                </div>
                {% endif %}
            </div>
            <div class="kpi-body">
                <h3>{{ nbCommandesEnCours }}</h3>
                <p>Commandes en cours</p>
                <div class="kpi-footer">
                    <small class="text-muted">À traiter rapidement</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Validées -->
    <div class="col-md-6 col-xl-3">
        <div class="kpi-card fade-in-up" style="animation-delay: 0.4s;">
            <div class="kpi-header">
                <div class="kpi-icon bg-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <div class="kpi-body">
                <h3>{{ nbCommandesValidees }}</h3>
                <p>Commandes terminées</p>
                <div class="kpi-footer">
                    {% set tauxReussite = (nbCommandesValidees + nbCommandesEnCours) > 0 ? (nbCommandesValidees / (nbCommandesValidees + nbCommandesEnCours + nbCommandesAnnulees) * 100) : 0 %}
                    <small class="text-success">Taux de réussite : {{ tauxReussite|number_format(1) }}%</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Commandes récentes en cours -->
<div class="row">
    <div class="col-12">
        <div class="card fade-in-up" style="animation-delay: 0.5s;">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history"></i>
                    <h5 class="mb-0">Commandes en cours - Surveillance temps réel</h5>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" onclick="location.reload()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
                    </button>
                    <a href="{{ path('app_gestionnaire_commandes') }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrow-right me-1"></i>Voir tout
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                {% if commandesEnCours|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>N° Commande</th>
                                <th>Client</th>
                                <th>Type</th>
                                <th>Montant</th>
                                <th>État</th>
                                <th>Temps écoulé</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for commande in commandesEnCours|slice(0, 10) %}
                            {% set minutesEcoulees = date().diff(commande.dateCommande).i + (date().diff(commande.dateCommande).h * 60) %}
                            <tr class="{% if minutesEcoulees >= 30 %}table-warning{% endif %}">
                                <td>
                                    <span class="order-number">#{{ commande.numero }}</span>
                                    {% if minutesEcoulees >= 30 %}
                                    <span class="badge bg-danger ms-1">URGENT</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="client-avatar">
                                            {{ commande.client.prenom|first|upper }}
                                        </div>
                                        <div>
                                            <strong>{{ commande.client.nomComplet }}</strong><br>
                                            <small class="text-muted">{{ commande.client.telephone }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="type-badge {{ commande.isLivraison ? 'delivery' : 'pickup' }}">
                                        <i class="bi bi-{{ commande.isLivraison ? 'truck' : 'shop' }}"></i>
                                        {{ commande.typeServiceLabel }}
                                    </span>
                                </td>
                                <td><strong>{{ commande.montantTotal|number_format(0, ',', ' ') }} FCFA</strong></td>
                                <td><span class="badge {{ commande.etatBadgeClass }}">{{ commande.etatLabel }}</span></td>
                                <td>
                                    <span class="time-elapsed {% if minutesEcoulees >= 30 %}text-danger fw-bold{% endif %}">
                                        <i class="bi bi-{% if minutesEcoulees >= 30 %}exclamation-triangle-fill{% else %}clock{% endif %}"></i>
                                        {% if minutesEcoulees >= 60 %}
                                            {{ (minutesEcoulees / 60)|number_format(0) }}h {{ minutesEcoulees % 60 }}min
                                        {% else %}
                                            {{ minutesEcoulees }} min
                                        {% endif %}
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_gestionnaire_commande_show', {id: commande.id}) }}" 
                                           class="btn btn-outline-primary" title="Voir détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h4>Aucune commande en cours</h4>
                    <p>Toutes les commandes d'aujourd'hui ont été traitées</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    /* KPI Cards professionnelles */
    .kpi-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        border: 1px solid #f1f5f9;
    }
    
    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
    
    .kpi-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    
    .kpi-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }
    
    .kpi-icon.bg-yellow {
        background: linear-gradient(135deg, #FFD700, #e6c200);
        color: #1a1a1a;
    }
    
    .kpi-icon.bg-black {
        background: linear-gradient(135deg, #1a1a1a, #2d2d2d);
        color: #FFD700;
    }
    
    .kpi-icon.bg-info {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
    }
    
    .kpi-icon.bg-success {
        background: linear-gradient(135deg, #22c55e, #16a34a);
    }
    
    .kpi-trend {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    
    .kpi-trend.positive {
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
    }
    
    .kpi-trend.negative {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
    }
    
    .kpi-badge.urgent {
        padding: 4px 10px;
        border-radius: 12px;
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    
    .kpi-body h3 {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 8px 0;
    }
    
    .kpi-body h3 small {
        font-size: 0.5em;
        font-weight: 500;
        color: #64748b;
    }
    
    .kpi-body p {
        color: #64748b;
        margin: 0;
        font-size: 0.95rem;
        font-weight: 500;
    }
    
    .kpi-footer {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #f1f5f9;
    }
    
    /* Alertes */
    .alert {
        border-left: 4px solid;
    }
    
    .alert-warning {
        border-left-color: #eab308;
    }
    
    /* Time elapsed styling */
    .time-elapsed {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.9rem;
    }
    
    .table-warning {
        background-color: rgba(234, 179, 8, 0.1) !important;
    }
    
    
    .order-number {
        font-weight: 700;
        color: #1a1a1a;
    }
    
    .client-avatar {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #FFD700, #e6c200);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1a1a1a;
        font-weight: 600;
        font-size: 0.8rem;
    }
    
    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 500;
    }
    
    .type-badge.delivery {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }
    
    .type-badge.pickup {
        background: rgba(139, 92, 246, 0.1);
        color: #8b5cf6;
    }
    
    .time-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--text-muted);
        font-size: 0.85rem;
    }
    
    .stat-card h3 small {
        font-size: 0.6em;
        font-weight: 500;
    }
</style>
{% endblock %}

{% block javascripts %}
<script>
    // Auto-refresh désactivé pour éviter les timeout - peut être réactivé avec un intervalle plus long
    // Décommenter la ligne ci-dessous pour activer le refresh toutes les 2 minutes (120 secondes)
    // setTimeout(function() { location.reload(); }, 120000);
    
    // Notification pour commandes urgentes (optionnel)
    {% if nbCommandesUrgentes > 0 %}
    if ('Notification' in window) {
        if (Notification.permission === 'granted') {
            new Notification('Brasil Burger - Alerte', {
                body: 'Vous avez {{ nbCommandesUrgentes }} commande(s) urgente(s) !',
                icon: '/favicon.ico'
            });
        } else if (Notification.permission !== 'denied') {
            Notification.requestPermission().then(function (permission) {
                if (permission === 'granted') {
                    new Notification('Brasil Burger - Alerte', {
                        body: 'Vous avez {{ nbCommandesUrgentes }} commande(s) urgente(s) !',
                        icon: '/favicon.ico'
                    });
                }
            });
        }
    }
    {% endif %}
    
    // Bouton de refresh manuel
    const refreshBtn = document.createElement('button');
    refreshBtn.className = 'btn btn-sm btn-outline-secondary position-fixed bottom-0 end-0 m-3';
    refreshBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Actualiser';
    refreshBtn.style.zIndex = '1000';
    refreshBtn.onclick = () => location.reload();
    document.body.appendChild(refreshBtn);
</script>
{% endblock %}