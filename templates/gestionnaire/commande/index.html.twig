{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Gestion des Commandes - Brasil Burger{% endblock %}

{% block page_title %}Gestion des Commandes{% endblock %}

{% block body %}
<!-- Filtres -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Filtres</h6>
    </div>
    <div class="card-body">
        <form method="get" action="{{ path('app_gestionnaire_commandes') }}">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Etat</label>
                    <select name="etat" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        <option value="EN_ATTENTE" {{ filtres.etat == 'EN_ATTENTE' ? 'selected' : '' }}>En attente</option>
                        <option value="EN_PREPARATION" {{ filtres.etat == 'EN_PREPARATION' ? 'selected' : '' }}>En preparation</option>
                        <option value="PRETE" {{ filtres.etat == 'PRETE' ? 'selected' : '' }}>Prete</option>
                        <option value="TERMINEE" {{ filtres.etat == 'TERMINEE' ? 'selected' : '' }}>Terminee</option>
                        <option value="ANNULEE" {{ filtres.etat == 'ANNULEE' ? 'selected' : '' }}>Annulee</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type service</label>
                    <select name="type_service" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        <option value="SUR_PLACE" {{ filtres.type_service == 'SUR_PLACE' ? 'selected' : '' }}>Sur place</option>
                        <option value="A_EMPORTER" {{ filtres.type_service == 'A_EMPORTER' ? 'selected' : '' }}>A emporter</option>
                        <option value="LIVRAISON" {{ filtres.type_service == 'LIVRAISON' ? 'selected' : '' }}>Livraison</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Burger</label>
                    <select name="burger" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        {% for burger in burgers %}
                        <option value="{{ burger.id }}" {{ filtres.burger == burger.id ? 'selected' : '' }}>
                            {{ burger.nom }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Menu</label>
                    <select name="menu" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        {% for menu in menus %}
                        <option value="{{ menu.id }}" {{ filtres.menu == menu.id ? 'selected' : '' }}>
                            {{ menu.nom }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Client</label>
                    <select name="client" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        {% for client in clients %}
                        <option value="{{ client.id }}" {{ filtres.client == client.id ? 'selected' : '' }}>
                            {{ client.nomComplet }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date debut</label>
                    <input type="date" name="date_debut" class="form-control form-control-sm" value="{{ filtres.date_debut }}">
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-2">
                    <label class="form-label">Date fin</label>
                    <input type="date" name="date_fin" class="form-control form-control-sm" value="{{ filtres.date_fin }}">
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-search me-1"></i> Filtrer
                    </button>
                    <a href="{{ path('app_gestionnaire_commandes') }}" class="btn btn-secondary btn-sm">
                        <i class="bi bi-x-lg me-1"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Liste des commandes -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Liste des commandes</h5>
        <span class="badge bg-primary">{{ commandes|length }} commande(s)</span>
    </div>
    <div class="card-body">
        {% if commandes|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>N Commande</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Montant</th>
                        <th>Paiement</th>
                        <th>Etat</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                    <tr>
                        <td><strong>{{ commande.numero }}</strong></td>
                        <td>
                            {{ commande.client.nomComplet }}<br>
                            <small class="text-muted">{{ commande.client.telephone }}</small>
                        </td>
                        <td>
                            {{ commande.dateCommande|date('d/m/Y') }}<br>
                            <small class="text-muted">{{ commande.dateCommande|date('H:i') }}</small>
                        </td>
                        <td>{{ commande.typeServiceLabel }}</td>
                        <td><strong>{{ commande.montantTotal|number_format(0, ',', ' ') }} F</strong></td>
                        <td>
                            {% if commande.paye %}
                                <span class="badge bg-success">Paye</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">Non paye</span>
                            {% endif %}
                        </td>
                        <td><span class="badge {{ commande.etatBadgeClass }}">{{ commande.etatLabel }}</span></td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_gestionnaire_commande_show', {id: commande.id}) }}" 
                                   class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                {% if commande.etat == 'PRETE' %}
                                <form action="{{ path('app_gestionnaire_commande_terminer', {id: commande.id}) }}" 
                                      method="post" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ commande.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Terminer">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                                {% endif %}
                                {% if commande.etat not in ['TERMINEE', 'ANNULEE'] %}
                                <form action="{{ path('app_gestionnaire_commande_annuler', {id: commande.id}) }}" 
                                      method="post" style="display: inline;"
                                      onsubmit="return confirm('Etes-vous sur de vouloir annuler cette commande ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ commande.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Annuler">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Aucune commande trouvee</h4>
            <p>Modifiez vos filtres ou attendez de nouvelles commandes</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}