{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Statistiques - Brasil Burger{% endblock %}

{% block page_title %}Statistiques{% endblock %}

{% block body %}
<!-- Selecteur de date -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row align-items-end">
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control" value="{{ date|date('Y-m-d') }}">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>Afficher
                </button>
            </div>
            <div class="col-md-7 text-end">
                <a href="{{ path('app_gestionnaire_statistiques', {date: 'now'|date('Y-m-d')}) }}" class="btn btn-outline-secondary">
                    Aujourd'hui
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Statistiques principales -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <h3>{{ stats.commandesEnCours }}</h3>
            <p>Commandes en cours</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h3>{{ stats.commandesValidees }}</h3>
            <p>Commandes validees</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(243, 156, 18, 0.1); color: #f39c12;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h3>{{ stats.recette|number_format(0, ',', ' ') }} F</h3>
            <p>Recette journaliere</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="bi bi-x-circle"></i>
            </div>
            <h3>{{ stats.commandesAnnulees }}</h3>
            <p>Commandes annulees</p>
        </div>
    </div>
</div>

<!-- Statistiques secondaires -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                <i class="bi bi-receipt"></i>
            </div>
            <h3>{{ stats.totalCommandes }}</h3>
            <p>Total commandes du jour</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="icon" style="background: rgba(6, 182, 212, 0.1); color: #06b6d4;">
                <i class="bi bi-cart"></i>
            </div>
            <h3>{{ stats.panierMoyen|number_format(0, ',', ' ') }} F</h3>
            <p>Panier moyen</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Repartition par type de service -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Repartition par type</h6>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 250px;">
                    <canvas id="chartRepartition"></canvas>
                </div>
                <div class="mt-3">
                    {% for key, data in commandesParType %}
                    <div class="d-flex justify-content-between small mb-1">
                        <span>
                            <span class="badge {% if key == 'SUR_PLACE' %}bg-primary{% elseif key == 'A_EMPORTER' %}bg-warning{% else %}bg-success{% endif %}">{{ data.total }}</span>
                            {{ data.label }}
                        </span>
                        <span class="text-muted">{{ data.montant|number_format(0, ',', ' ') }} F</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <!-- Burgers les plus vendus -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-trophy me-2"></i>Burgers les plus vendus</h6>
            </div>
            <div class="card-body p-0">
                {% if produitsVendus.burgers|length > 0 %}
                <ul class="list-group list-group-flush">
                    {% for burger in produitsVendus.burgers %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            {% if burger.image %}
                            <img src="{{ burger.image }}" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;" class="me-2">
                            {% endif %}
                            <span>{{ burger.nom }}</span>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary">{{ burger.quantite }} vendus</span><br>
                            <small class="text-muted">{{ burger.chiffre|number_format(0, ',', ' ') }} F</small>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">Aucune vente de burger</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Menus les plus vendus -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-award me-2"></i>Menus les plus vendus</h6>
            </div>
            <div class="card-body p-0">
                {% if produitsVendus.menus|length > 0 %}
                <ul class="list-group list-group-flush">
                    {% for menu in produitsVendus.menus %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            {% if menu.image %}
                            <img src="{{ menu.image }}" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;" class="me-2">
                            {% endif %}
                            <span>{{ menu.nom }}</span>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info">{{ menu.quantite }} vendus</span><br>
                            <small class="text-muted">{{ menu.chiffre|number_format(0, ',', ' ') }} F</small>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">Aucune vente de menu</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Evolution sur 7 jours -->
<div class="card mt-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Evolution sur les 7 derniers jours</h6>
    </div>
    <div class="card-body">
        <!-- Graphique Chart.js -->
        <div style="position: relative; height: 300px;">
            <canvas id="chartEvolution"></canvas>
        </div>
        
        <!-- Tableau récapitulatif -->
        <div class="table-responsive mt-4">
            <table class="table table-sm table-bordered text-center">
                <thead class="table-light">
                    <tr>
                        {% for jour in evolution %}
                        <th><small>{{ jour.date }}<br>{{ jour.jour }}</small></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        {% for jour in evolution %}
                        <td>
                            <strong>{{ jour.commandes }}</strong> cmd<br>
                            <small class="text-success">{{ jour.recette|number_format(0, ',', ' ') }} F</small>
                        </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Graphique Camembert - Répartition par type
    const ctxRepartition = document.getElementById('chartRepartition');
    if (ctxRepartition) {
        new Chart(ctxRepartition, {
            type: 'doughnut',
            data: {
                labels: ['Sur place', 'À emporter', 'Livraison'],
                datasets: [{
                    data: [
                        {{ commandesParType.SUR_PLACE.total }},
                        {{ commandesParType.A_EMPORTER.total }},
                        {{ commandesParType.LIVRAISON.total }}
                    ],
                    backgroundColor: [
                        '#0d6efd',
                        '#ffc107',
                        '#198754'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.raw || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                return label + ': ' + value + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    }

    // Graphique Barres/Ligne - Evolution 7 jours
    const ctxEvolution = document.getElementById('chartEvolution');
    if (ctxEvolution) {
        new Chart(ctxEvolution, {
            type: 'bar',
            data: {
                labels: [{% for jour in evolution %}'{{ jour.date }} {{ jour.jour }}'{{ loop.last ? '' : ',' }}{% endfor %}],
                datasets: [
                    {
                        label: 'Recettes (F)',
                        data: [{% for jour in evolution %}{{ jour.recette }}{{ loop.last ? '' : ',' }}{% endfor %}],
                        backgroundColor: 'rgba(230, 57, 70, 0.7)',
                        borderColor: '#e63946',
                        borderWidth: 2,
                        borderRadius: 5,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Commandes',
                        data: [{% for jour in evolution %}{{ jour.commandes }}{{ loop.last ? '' : ',' }}{% endfor %}],
                        type: 'line',
                        borderColor: '#1d3557',
                        backgroundColor: '#1d3557',
                        tension: 0.3,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.datasetIndex === 0) {
                                    label += new Intl.NumberFormat('fr-FR').format(context.raw) + ' F';
                                } else {
                                    label += context.raw;
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Recettes (F)'
                        },
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('fr-FR').format(value);
                            }
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Commandes'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    }
                }
            }
        });
    }
});
</script>
{% endblock %}