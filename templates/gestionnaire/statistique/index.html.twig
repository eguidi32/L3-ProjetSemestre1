{% extends 'gestionnaire/base.html.twig' %}

{% block title %}Statistiques - Brasil Burger{% endblock %}

{% block page_title %}Statistiques{% endblock %}

{% block body %}
<!-- Selecteur de date -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row align-items-end">
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control" value="{{ date|date('Y-m-d') }}">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>Afficher
                </button>
            </div>
            <div class="col-md-7 text-end">
                <a href="{{ path('app_gestionnaire_statistiques', {date: 'now'|date('Y-m-d')}) }}" class="btn btn-outline-secondary">
                    Aujourd'hui
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Statistiques principales -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <h3>{{ stats.commandesEnCours }}</h3>
            <p>Commandes en cours</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h3>{{ stats.commandesValidees }}</h3>
            <p>Commandes validees</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(243, 156, 18, 0.1); color: #f39c12;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h3>{{ stats.recette|number_format(0, ',', ' ') }} F</h3>
            <p>Recette journaliere</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="bi bi-x-circle"></i>
            </div>
            <h3>{{ stats.commandesAnnulees }}</h3>
            <p>Commandes annulees</p>
        </div>
    </div>
</div>

<!-- Statistiques secondaires -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                <i class="bi bi-receipt"></i>
            </div>
            <h3>{{ stats.totalCommandes }}</h3>
            <p>Total commandes du jour</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="icon" style="background: rgba(6, 182, 212, 0.1); color: #06b6d4;">
                <i class="bi bi-cart"></i>
            </div>
            <h3>{{ stats.panierMoyen|number_format(0, ',', ' ') }} F</h3>
            <p>Panier moyen</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Repartition par type de service -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Repartition par type</h6>
            </div>
            <div class="card-body">
                {% set totalType = commandesParType.SUR_PLACE.total + commandesParType.A_EMPORTER.total + commandesParType.LIVRAISON.total %}
                
                {% for key, data in commandesParType %}
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>{{ data.label }}</span>
                        <span><strong>{{ data.total }}</strong> ({{ data.montant|number_format(0, ',', ' ') }} F)</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                        {% set percent = totalType > 0 ? (data.total / totalType * 100) : 0 %}
                        <div class="progress-bar 
                            {% if key == 'SUR_PLACE' %}bg-primary{% elseif key == 'A_EMPORTER' %}bg-warning{% else %}bg-success{% endif %}" 
                             style="width: {{ percent }}%"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Burgers les plus vendus -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-trophy me-2"></i>Burgers les plus vendus</h6>
            </div>
            <div class="card-body p-0">
                {% if produitsVendus.burgers|length > 0 %}
                <ul class="list-group list-group-flush">
                    {% for burger in produitsVendus.burgers %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            {% if burger.image %}
                            <img src="{{ burger.image }}" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;" class="me-2">
                            {% endif %}
                            <span>{{ burger.nom }}</span>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary">{{ burger.quantite }} vendus</span><br>
                            <small class="text-muted">{{ burger.chiffre|number_format(0, ',', ' ') }} F</small>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">Aucune vente de burger</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Menus les plus vendus -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-award me-2"></i>Menus les plus vendus</h6>
            </div>
            <div class="card-body p-0">
                {% if produitsVendus.menus|length > 0 %}
                <ul class="list-group list-group-flush">
                    {% for menu in produitsVendus.menus %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            {% if menu.image %}
                            <img src="{{ menu.image }}" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;" class="me-2">
                            {% endif %}
                            <span>{{ menu.nom }}</span>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info">{{ menu.quantite }} vendus</span><br>
                            <small class="text-muted">{{ menu.chiffre|number_format(0, ',', ' ') }} F</small>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">Aucune vente de menu</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Evolution sur 7 jours -->
<div class="card mt-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Evolution sur les 7 derniers jours</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered text-center">
                <thead class="table-light">
                    <tr>
                        {% for jour in evolution %}
                        <th>{{ jour.date }}<br><small class="text-muted">{{ jour.jour }}</small></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        {% for jour in evolution %}
                        <td>
                            <strong>{{ jour.commandes }}</strong><br>
                            <small class="text-muted">cmd</small>
                        </td>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for jour in evolution %}
                        <td>
                            <strong class="text-success">{{ jour.recette|number_format(0, ',', ' ') }}</strong><br>
                            <small class="text-muted">F</small>
                        </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Graphique simple en barres CSS -->
        <div class="mt-4">
            <h6 class="text-muted mb-3">Recettes journalieres</h6>
            <div class="d-flex align-items-end justify-content-between" style="height: 150px;">
                {% set maxRecette = 1 %}
                {% for jour in evolution %}
                    {% if jour.recette > maxRecette %}
                        {% set maxRecette = jour.recette %}
                    {% endif %}
                {% endfor %}
                
                {% for jour in evolution %}
                {% set height = maxRecette > 0 ? (jour.recette / maxRecette * 100) : 0 %}
                <div class="text-center" style="flex: 1; padding: 0 5px;">
                    <div class="bg-primary rounded-top mx-auto" 
                         style="width: 40px; height: {{ height }}%; min-height: 5px;"
                         title="{{ jour.recette|number_format(0, ',', ' ') }} F"></div>
                    <small class="text-muted d-block mt-2">{{ jour.date }}</small>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}