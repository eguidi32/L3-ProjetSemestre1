<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        main {
            margin: 0 !important;
            padding: 0 !important;
        }
        
        .navbar-brasil {
            background-color: #000000ff !important;
            padding: 10px 0;
            border: none;
            margin-bottom: 0 !important;
        }
        .navbar-brasil .nav-link {
            color: #FFCD29 !important;
            font-weight: 500;
            font-size: 15px;
            transition: color 0.3s ease;
        }
        .navbar-brasil .nav-link:hover {
            color: #ffffff !important;
        }
        .btn-outline-warning-custom {
            border: 2px solid #FFCD29;
            color: #FFCD29;
            background: transparent;
            border-radius: 5px;
            padding: 8px 25px;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .btn-outline-warning-custom:hover {
            background-color: #FFCD29;
            color: #1a1a1a;
        }
        .cart-icon {
            color: #FFCD29 !important;
            font-size: 1.4rem;
        }
        .logo-img {
            height: 70px;
            width: auto;
            max-width: 200px;
            object-fit: contain;
            transition: transform 0.3s ease;
        }
        .logo-img:hover {
            transform: scale(1.05);
        }
        .navbar-brand {
            padding: 0.25rem 0;
            margin-right: 1.5rem;
        }
        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        .btn-warning {
            background-color: #FFCD29;
            border-color: #FFCD29;
            color: #1a1a1a;
            font-weight: 500;
        }
        .btn-warning:hover {
            background-color: #e0b13b;
            border-color: #e0b13b;
        }
        @@media (max-width: 768px) {
            .logo-img {
                height: 50px;
                max-width: 150px;
            }
            .navbar-brasil {
                padding: 8px 0;
            }
        }
        @@media (min-width: 769px) and (max-width: 1024px) {
            .logo-img {
                height: 60px;
                max-width: 180px;
            }
        }
        @@media (min-width: 1400px) {
            .logo-img {
                height: 80px;
                max-width: 220px;
            }
        }
        
        /* Menu hamburger en jaune */
        .navbar-toggler {
            border-color: #FFCD29 !important;
        }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%23FFCD29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-brasil shadow">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Brasil Burger" class="logo-img">
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto me-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalogue" asp-action="Index">
                                Catalogue
                            </a>
                        </li>
                        @if (Context.Session.GetInt32("ClientId") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Commande" asp-action="MesCommandes">
                                    Mes Commandes
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-3">
                            <a class="nav-link position-relative cart-icon" asp-controller="Commande" asp-action="Panier">
                                <i class="bi bi-cart3"></i>
                                @{
                                    var panier = Context.Session.GetObjectFromJson<List<PanierItem>>("Panier");
                                    var itemCount = panier?.Sum(p => p.Quantite) ?? 0;
                                    if (itemCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @itemCount
                                        </span>
                                    }
                                }
                            </a>
                        </li>
                        
                        @if (Context.Session.GetInt32("ClientId") == null)
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-warning-custom" asp-controller="Auth" asp-action="Login">
                                    Connexion
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" style="color: #f0c14b !important;">
                                    <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("ClientPrenom")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                    <li>
                                        <span class="dropdown-item-text">
                                            <strong>@Context.Session.GetString("ClientPrenom") @Context.Session.GetString("ClientNom")</strong>
                                            <br>
                                            <small class="text-muted">@Context.Session.GetString("ClientEmail")</small>
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Profil">
                                            <i class="bi bi-person me-2"></i> Mon Profil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Adresse">
                                            <i class="bi bi-geo-alt me-2"></i> Mon Adresse
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Commande" asp-action="MesCommandes">
                                            <i class="bi bi-bag-check me-2"></i> Mes Commandes
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="margin: 0; padding: 0;">
        @RenderBody()
    </main>

    <footer class="text-white py-5" style="background-color: #000000;">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4 mb-md-0">
                    <img src="~/images/logo.png" alt="Brasil Burger" style="height: 50px;" class="mb-3">
                    <p class="text-muted mb-3">
                        Les meilleurs burgers de la ville, préparés avec passion et des ingrédients frais.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-warning" title="Facebook">
                            <i class="bi bi-facebook fs-4"></i>
                        </a>
                        <a href="#" class="text-warning" title="Instagram">
                            <i class="bi bi-instagram fs-4"></i>
                        </a>
                        <a href="#" class="text-warning" title="Twitter">
                            <i class="bi bi-twitter fs-4"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-3 mb-4 mb-md-0">
                    <h5 class="text-warning mb-3">Navigation</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">
                                <i class="bi bi-house me-2"></i>Accueil
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Catalogue" asp-action="Index" class="text-muted text-decoration-none">
                                <i class="bi bi-grid me-2"></i>Catalogue
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Commande" asp-action="Panier" class="text-muted text-decoration-none">
                                <i class="bi bi-cart me-2"></i>Mon Panier
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Commande" asp-action="MesCommandes" class="text-muted text-decoration-none">
                                <i class="bi bi-bag me-2"></i>Mes Commandes
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4 mb-md-0">
                    <h5 class="text-warning mb-3">Informations</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">À propos</a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">Mentions légales</a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">CGV</a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">Contact</a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5 class="text-warning mb-3">Contact</h5>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2">
                            <i class="bi bi-telephone me-2"></i>+221 77 123 45 67
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope me-2"></i>contact@brasilburger.sn
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-geo-alt me-2"></i>Dakar, Sénégal
                        </li>
                        <li class="mt-3">
                            <i class="bi bi-clock me-2"></i>
                            <small>Lun-Ven: 11h-22h<br>Sam-Dim: 12h-23h</small>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-muted">
                <small>&copy; @DateTime.Now.Year Brasil Burger - Tous droits réservés</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>