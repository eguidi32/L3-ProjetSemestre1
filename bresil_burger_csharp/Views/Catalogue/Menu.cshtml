@model Menu
@{
    ViewData["Title"] = Model.Nom;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Catalogue</a></li>
            <li class="breadcrumb-item active">@Model.Nom</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-md-6">
            <img src="@Model.Image" class="img-fluid rounded shadow" alt="@Model.Nom"
                 style="max-height: 400px; width: 100%; object-fit: cover;"
                 onerror="this.src='https://via.placeholder.com/400x300?text=Menu'">
        </div>

        <div class="col-md-6">
            <h2 class="mb-3">@Model.Nom</h2>
            <p class="fs-3 text-warning fw-bold">@Model.Prix.ToString("N0") FCFA</p>

            <hr>

            <h5 class="mb-3">Composition du menu :</h5>
            <ul class="list-group mb-4">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-circle-fill text-danger me-2"></i> @Model.Burger?.Nom</span>
                    <span class="badge bg-warning text-dark">@Model.Burger?.Prix.ToString("N0") FCFA</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-cup-straw text-info me-2"></i> @Model.Boisson?.Nom</span>
                    <span class="badge bg-warning text-dark">@Model.Boisson?.Prix.ToString("N0") FCFA</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-basket text-success me-2"></i> @Model.Frite?.Nom</span>
                    <span class="badge bg-warning text-dark">@Model.Frite?.Prix.ToString("N0") FCFA</span>
                </li>
            </ul>

            <form asp-controller="Commande" asp-action="AjouterAuPanier" method="post">
                <input type="hidden" name="type" value="menu" />
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label for="quantite" class="form-label">Quantité</label>
                    <input type="number" class="form-control" id="quantite" name="quantite" 
                           value="1" min="1" max="10" style="width: 100px;">
                </div>

                <button type="submit" class="btn btn-warning btn-lg w-100">
                    <i class="bi bi-cart-plus me-2"></i> Ajouter au panier
                </button>
            </form>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>