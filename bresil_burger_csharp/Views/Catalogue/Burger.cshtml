@model Burger
@{
    ViewData["Title"] = Model.Nom;
    var complements = ViewBag.Complements as List<Complement> ?? new List<Complement>();
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Catalogue</a></li>
            <li class="breadcrumb-item active">@Model.Nom</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <!-- Image du Burger -->
        <div class="col-md-6">
            <img src="@Model.Image" class="img-fluid rounded shadow" alt="@Model.Nom"
                 style="max-height: 400px; width: 100%; object-fit: cover;"
                 onerror="this.src='https://via.placeholder.com/400x300?text=Burger'">
        </div>

        <!-- Détails et Commande -->
        <div class="col-md-6">
            <h2 class="mb-3">@Model.Nom</h2>
            <p class="fs-3 text-warning fw-bold">@Model.Prix.ToString("N0") FCFA</p>

            <hr>

            <form asp-controller="Commande" asp-action="AjouterAuPanier" method="post">
                <input type="hidden" name="type" value="burger" />
                <input type="hidden" name="id" value="@Model.Id" />

                <!-- Compléments optionnels -->
                @if (complements.Any())
                {
                    <h5 class="mb-3">🍟 Ajouter des compléments ?</h5>
                    
                    <div class="mb-3">
                        @foreach (var complement in complements)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" 
                                       name="complementIds" value="@complement.Id" 
                                       id="comp_@complement.Id">
                                <label class="form-check-label" for="comp_@complement.Id">
                                    @complement.Nom 
                                    <span class="text-warning">(+@complement.Prix.ToString("N0") FCFA)</span>
                                </label>
                            </div>
                        }
                    </div>
                }

                <!-- Quantité -->
                <div class="mb-3">
                    <label for="quantite" class="form-label">Quantité</label>
                    <input type="number" class="form-control" id="quantite" name="quantite" 
                           value="1" min="1" max="10" style="width: 100px;">
                </div>

                <!-- Bouton Ajouter -->
                <button type="submit" class="btn btn-warning btn-lg w-100">
                    🛒 Ajouter au panier
                </button>
            </form>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    ← Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>