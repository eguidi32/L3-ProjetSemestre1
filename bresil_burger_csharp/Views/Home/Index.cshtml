@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center mb-5">
    <h1 class="display-4 text-danger fw-bold">Bienvenue chez Brasil Burger 🍔</h1>
    <p class="lead">Les meilleurs burgers de la ville, livrés directement chez vous !</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-egg-fried text-danger" style="font-size: 4rem;"></i>
                <h4 class="mt-3">Burgers de qualité</h4>
                <p class="text-muted">Ingrédients frais et de première qualité pour des burgers savoureux</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-truck text-danger" style="font-size: 4rem;"></i>
                <h4 class="mt-3">Livraison rapide</h4>
                <p class="text-muted">Commandez en ligne et recevez votre repas où vous voulez</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-star-fill text-danger" style="font-size: 4rem;"></i>
                <h4 class="mt-3">Service excellent</h4>
                <p class="text-muted">Une expérience client exceptionnelle à chaque commande</p>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center mb-5">
    <div class="col-md-6">
        <h2 class="text-danger mb-3">Découvrez notre menu</h2>
        <p class="lead">Nous proposons une large sélection de burgers savoureux et de menus complets pour satisfaire tous les goûts.</p>
        <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Burgers classiques et signature</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Menus complets avec boisson et frites</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Accompagnements et boissons variés</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Options végétariennes disponibles</li>
        </ul>
        <div class="mt-4">
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-danger btn-lg">
                <i class="bi bi-grid-3x3-gap"></i> Voir le catalogue
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="bg-danger rounded shadow p-5 text-center text-white">
            <i class="bi bi-shop" style="font-size: 8rem;"></i>
            <h3 class="mt-3">Brasil Burger</h3>
            <p>Votre destination pour les meilleurs burgers !</p>
        </div>
    </div>
</div>

<div class="bg-light rounded p-5 text-center mb-5">
    <h3 class="mb-4">Comment commander ?</h3>
    <div class="row g-4">
        <div class="col-md-3">
            <div class="mb-3">
                <span class="badge bg-danger rounded-circle p-3" style="font-size: 1.5rem;">1</span>
            </div>
            <h5>Parcourez le catalogue</h5>
            <p class="text-muted">Découvrez nos burgers et menus</p>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <span class="badge bg-danger rounded-circle p-3" style="font-size: 1.5rem;">2</span>
            </div>
            <h5>Ajoutez au panier</h5>
            <p class="text-muted">Sélectionnez vos produits favoris</p>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <span class="badge bg-danger rounded-circle p-3" style="font-size: 1.5rem;">3</span>
            </div>
            <h5>Passez commande</h5>
            <p class="text-muted">Choisissez votre mode de livraison</p>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <span class="badge bg-danger rounded-circle p-3" style="font-size: 1.5rem;">4</span>
            </div>
            <h5>Réglez et dégustez</h5>
            <p class="text-muted">Payez et savourez votre repas !</p>
        </div>
    </div>
</div>

@if (Context.Session.GetInt32("UserId") == null)
{
    <div class="alert alert-info text-center">
        <h5><i class="bi bi-info-circle"></i> Nouveau ici ?</h5>
        <p class="mb-3">Créez un compte pour commencer à passer vos commandes en ligne !</p>
        <a asp-controller="Auth" asp-action="Register" class="btn btn-danger me-2">
            <i class="bi bi-person-plus"></i> S'inscrire
        </a>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-danger">
            <i class="bi bi-box-arrow-in-right"></i> Se connecter
        </a>
    </div>
}
