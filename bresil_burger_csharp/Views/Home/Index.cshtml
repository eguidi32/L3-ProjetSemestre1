@{
    ViewData["Title"] = "Accueil";
}

<!-- Hero Section -->
<div class="bg-warning py-5">
    <div class="container text-center">
        <h1 class="display-3 fw-bold text-dark">🍔 Brasil Burger</h1>
        <p class="lead text-dark mb-4">Les meilleurs burgers de la ville, préparés avec amour !</p>
        <a asp-controller="Catalogue" asp-action="Index" class="btn btn-danger btn-lg px-5">
            Voir notre menu
        </a>
    </div>
</div>

<!-- Features Section -->
<div class="container py-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="display-4 text-warning mb-3">🍔</div>
                    <h4 class="card-title">Burgers Savoureux</h4>
                    <p class="card-text text-muted">
                        Des burgers préparés avec des ingrédients frais et de qualité.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="display-4 text-warning mb-3">🍟</div>
                    <h4 class="card-title">Menus Complets</h4>
                    <p class="card-text text-muted">
                        Burger + Frites + Boisson à prix avantageux !
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="display-4 text-warning mb-3">🛵</div>
                    <h4 class="card-title">Livraison Rapide</h4>
                    <p class="card-text text-muted">
                        Livraison dans toutes les zones de la ville !
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="bg-danger text-white py-5">
    <div class="container text-center">
        <h2 class="mb-4">Prêt à commander ?</h2>
        <p class="lead mb-4">Créez un compte et commandez en quelques clics !</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-warning btn-lg">
                📋 Voir le catalogue
            </a>
            @if (Context.Session.GetInt32("ClientId") == null)
            {
                <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light btn-lg">
                    📝 S'inscrire
                </a>
            }
        </div>
    </div>
</div>

<!-- Comment ça marche -->
<div class="container py-5">
    <h2 class="text-center mb-5">Comment ça marche ?</h2>
    <div class="row g-4">
        <div class="col-md-3 text-center">
            <div class="rounded-circle bg-warning d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <span class="display-6 text-dark">1</span>
            </div>
            <h5>Choisissez</h5>
            <p class="text-muted small">Parcourez notre catalogue de burgers et menus</p>
        </div>
        <div class="col-md-3 text-center">
            <div class="rounded-circle bg-warning d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <span class="display-6 text-dark">2</span>
            </div>
            <h5>Commandez</h5>
            <p class="text-muted small">Ajoutez au panier et validez votre commande</p>
        </div>
        <div class="col-md-3 text-center">
            <div class="rounded-circle bg-warning d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <span class="display-6 text-dark">3</span>
            </div>
            <h5>Payez</h5>
            <p class="text-muted small">Payez par Wave ou Orange Money</p>
        </div>
        <div class="col-md-3 text-center">
            <div class="rounded-circle bg-warning d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <span class="display-6 text-dark">4</span>
            </div>
            <h5>Savourez</h5>
            <p class="text-muted small">Sur place, à emporter ou livré chez vous !</p>
        </div>
    </div>
</div>