@model ValidationCommandeViewModel
@{
    ViewData["Title"] = "Valider la commande";
}

<div class="container">
    <h2 class="my-4">✅ Validation de la commande</h2>

    <div class="row">
        <!-- Récapitulatif -->
        <div class="col-md-7">
            <div class="card shadow mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">📋 Récapitulatif</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            @foreach (var item in Model.Panier.Items)
                            {
                                <tr>
                                    <td>
                                        @item.Nom
                                        <span class="badge @(item.Type == "burger" ? "bg-danger" : "bg-success")">
                                            @item.Type
                                        </span>
                                    </td>
                                    <td class="text-center">x @item.Quantite</td>
                                    <td class="text-end">@((item.Prix * item.Quantite).ToString("N0")) FCFA</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="text-end fw-bold">Sous-total :</td>
                                <td class="text-end fw-bold">@Model.Panier.Total.ToString("N0") FCFA</td>
                            </tr>
                            <tr id="fraisLivraisonRow" style="display: none;">
                                <td colspan="2" class="text-end">Frais de livraison :</td>
                                <td class="text-end" id="fraisLivraison">0 FCFA</td>
                            </tr>
                            <tr class="table-warning">
                                <td colspan="2" class="text-end fw-bold fs-5">Total :</td>
                                <td class="text-end fw-bold fs-5" id="totalCommande">@Model.Panier.Total.ToString("N0") FCFA</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Options de livraison -->
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">🚗 Mode de livraison</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Confirmer" method="post">
                        <div class="mb-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="TypeLivraison" 
                                       id="surPlace" value="sur_place" checked onchange="updateLivraison()">
                                <label class="form-check-label" for="surPlace">
                                    🍽️ Sur place
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="TypeLivraison" 
                                       id="aEmporter" value="a_emporter" onchange="updateLivraison()">
                                <label class="form-check-label" for="aEmporter">
                                    🥡 À emporter
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="TypeLivraison" 
                                       id="livraison" value="livraison" onchange="updateLivraison()">
                                <label class="form-check-label" for="livraison">
                                    🛵 Livraison
                                </label>
                            </div>
                        </div>

                        <!-- Zone de livraison -->
                        <div class="mb-3" id="zoneSelection" style="display: none;">
                            <label for="ZoneId" class="form-label">Zone de livraison</label>
                            <select class="form-select" name="ZoneId" id="ZoneId" onchange="updateFrais()">
                                <option value="">-- Choisir une zone --</option>
                                @foreach (var zone in Model.Zones)
                                {
                                    <option value="@zone.Id" data-prix="@zone.PrixLivraison">
                                        @zone.Nom - @zone.PrixLivraison.ToString("N0") FCFA
                                    </option>
                                }
                            </select>
                        </div>

                        <hr>

                        <button type="submit" class="btn btn-warning btn-lg w-100">
                            💳 Procéder au paiement
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Panier" class="btn btn-outline-secondary">
                    ← Retour au panier
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var sousTotal = @Model.Panier.Total;

        function updateLivraison() {
            var livraisonSelected = document.getElementById('livraison').checked;
            var zoneSelection = document.getElementById('zoneSelection');
            var fraisRow = document.getElementById('fraisLivraisonRow');

            if (livraisonSelected) {
                zoneSelection.style.display = 'block';
                fraisRow.style.display = 'table-row';
                updateFrais();
            } else {
                zoneSelection.style.display = 'none';
                fraisRow.style.display = 'none';
                document.getElementById('totalCommande').textContent = sousTotal.toLocaleString() + ' FCFA';
            }
        }

        function updateFrais() {
            var select = document.getElementById('ZoneId');
            var option = select.options[select.selectedIndex];
            var frais = option ? parseFloat(option.getAttribute('data-prix')) || 0 : 0;

            document.getElementById('fraisLivraison').textContent = frais.toLocaleString() + ' FCFA';
            document.getElementById('totalCommande').textContent = (sousTotal + frais).toLocaleString() + ' FCFA';
        }
    </script>
}