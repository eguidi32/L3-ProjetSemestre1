@model ValidationCommandeViewModel
@{
    ViewData["Title"] = "Valider la commande";
    // Créer un dictionnaire JSON des zones et leurs quartiers
    var zonesData = Model.Zones.Select(z => new { 
        id = z.Id, 
        nom = z.Nom, 
        prix = z.PrixLivraison,
        quartiers = z.Quartiers?.ToLower() ?? ""
    }).ToList();
}

<div class="container">
    <h2 class="my-4"><i class="bi bi-check-circle me-2"></i>Validation de la commande</h2>

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Récapitulatif</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            @foreach (var item in Model.Panier.Items)
                            {
                                <tr>
                                    <td>
                                        @item.Nom
                                        <span class="badge @(item.Type == "burger" ? "bg-danger" : "bg-success")">
                                            @item.Type
                                        </span>
                                    </td>
                                    <td class="text-center">x @item.Quantite</td>
                                    <td class="text-end">@((item.Prix * item.Quantite).ToString("N0")) FCFA</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="text-end fw-bold">Sous-total :</td>
                                <td class="text-end fw-bold">@Model.Panier.Total.ToString("N0") FCFA</td>
                            </tr>
                            <tr id="fraisLivraisonRow" style="display: none;">
                                <td colspan="2" class="text-end">Frais de livraison :</td>
                                <td class="text-end" id="fraisLivraison">0 FCFA</td>
                            </tr>
                            <tr class="table-warning">
                                <td colspan="2" class="text-end fw-bold fs-5">Total :</td>
                                <td class="text-end fw-bold fs-5" id="totalCommande">@Model.Panier.Total.ToString("N0") FCFA</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Mode de livraison</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Confirmer" method="post">
                        <div class="mb-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="TypeLivraison" 
                                       id="surPlace" value="SUR_PLACE" checked onchange="updateLivraison()">
                                <label class="form-check-label" for="surPlace">
                                    <i class="bi bi-shop me-1"></i> Sur place
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="TypeLivraison" 
                                       id="aEmporter" value="A_EMPORTER" onchange="updateLivraison()">
                                <label class="form-check-label" for="aEmporter">
                                    <i class="bi bi-bag me-1"></i> À emporter
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="TypeLivraison" 
                                       id="livraison" value="LIVRAISON" onchange="updateLivraison()">
                                <label class="form-check-label" for="livraison">
                                    <i class="bi bi-truck me-1"></i> Livraison
                                </label>
                            </div>
                        </div>

                        <!-- Section Livraison (cachée par défaut) -->
                        <div id="livraisonSection" style="display: none;">
                            <!-- Saisie du quartier -->
                            <div class="mb-3">
                                <label for="quartierInput" class="form-label fw-bold">
                                    <i class="bi bi-geo-alt me-1"></i>Votre quartier
                                </label>
                                <input type="text" class="form-control" id="quartierInput" name="Quartier"
                                       placeholder="Ex: Fass, Colobane, Medina..." oninput="detecterZone()">
                                <small class="text-muted">Entrez votre quartier pour voir les frais de livraison</small>
                            </div>

                            <!-- Zone détectée automatiquement -->
                            <div id="zoneDetectee" class="alert alert-success mb-3" style="display: none;">
                                <i class="bi bi-check-circle me-1"></i>
                                <span id="zoneNom"></span> - Frais: <strong id="zonePrix"></strong> FCFA
                            </div>

                            <!-- Zone non trouvée -->
                            <div id="zoneNonTrouvee" class="alert alert-warning mb-3" style="display: none;">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Quartier non reconnu. Veuillez sélectionner une zone manuellement.
                            </div>

                            <!-- Sélection manuelle de zone (si non trouvée) -->
                            <div class="mb-3" id="zoneManuelleSection" style="display: none;">
                                <label for="ZoneId" class="form-label fw-bold">
                                    <i class="bi bi-map me-1"></i>Sélectionner une zone
                                </label>
                                <select class="form-select" name="ZoneId" id="ZoneId" onchange="updateFraisManuel()">
                                    <option value="">-- Choisir une zone --</option>
                                    @foreach (var zone in Model.Zones)
                                    {
                                        <option value="@zone.Id" data-prix="@zone.PrixLivraison">
                                            @zone.Nom - @zone.PrixLivraison.ToString("N0") FCFA
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Champ caché pour la zone détectée -->
                            <input type="hidden" name="ZoneIdDetectee" id="ZoneIdDetectee" value="" />

                            <!-- Adresse de livraison -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-house-door me-1"></i>Adresse complète
                                </label>
                                
                                @if (!string.IsNullOrEmpty(Model.AdresseEnregistree))
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="UtiliserAdresseEnregistree" 
                                               id="useExistingAddress" value="true" checked onchange="toggleAddressInput()">
                                        <label class="form-check-label" for="useExistingAddress">
                                            Utiliser mon adresse enregistrée
                                        </label>
                                    </div>
                                    
                                    <div id="existingAddressDisplay" class="alert alert-light border mb-2">
                                        <i class="bi bi-pin-map me-1"></i>
                                        <strong>@Model.AdresseEnregistree</strong>
                                        <input type="hidden" name="AdresseEnregistree" value="@Model.AdresseEnregistree" />
                                    </div>
                                    
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="UtiliserAdresseEnregistree" 
                                               id="useNewAddress" value="false" onchange="toggleAddressInput()">
                                        <label class="form-check-label" for="useNewAddress">
                                            Utiliser une autre adresse
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <input type="hidden" name="UtiliserAdresseEnregistree" value="false" />
                                }
                                
                                <div id="newAddressInput" style="display: @(string.IsNullOrEmpty(Model.AdresseEnregistree) ? "block" : "none");">
                                    <textarea class="form-control" name="NouvelleAdresse" id="NouvelleAdresse" 
                                              rows="2" placeholder="Adresse complète avec point de repère..."></textarea>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <button type="submit" class="btn btn-warning btn-lg w-100">
                            <i class="bi bi-credit-card me-2"></i> Procéder au paiement
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Panier" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour au panier
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    var sousTotal = @((int)Model.Panier.Total);
    var fraisLivraison = 0;
    var adresseEnregistree = '@(Model.AdresseEnregistree?.Replace("'", "\\'") ?? "")';
    
    // Données des zones depuis le serveur
    var zones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(zonesData));

    function updateLivraison() {
        var livraisonSelected = document.getElementById('livraison').checked;
        var livraisonSection = document.getElementById('livraisonSection');
        var fraisRow = document.getElementById('fraisLivraisonRow');

        if (livraisonSelected) {
            livraisonSection.style.display = 'block';
            fraisRow.style.display = 'table-row';
            // Si adresse enregistrée existe et est sélectionnée, détecter la zone
            var useExisting = document.getElementById('useExistingAddress');
            if (useExisting && useExisting.checked && adresseEnregistree) {
                detecterZoneDepuisAdresse(adresseEnregistree);
            }
        } else {
            livraisonSection.style.display = 'none';
            fraisRow.style.display = 'none';
            fraisLivraison = 0;
            updateTotal();
        }
    }

    function detecterZoneDepuisAdresse(adresse) {
        var zoneDetectee = document.getElementById('zoneDetectee');
        var zoneNonTrouvee = document.getElementById('zoneNonTrouvee');
        var zoneManuelle = document.getElementById('zoneManuelleSection');
        var zoneIdDetectee = document.getElementById('ZoneIdDetectee');
        var zoneSelect = document.getElementById('ZoneId');
        var quartierInput = document.getElementById('quartierInput');

        var adresseLower = adresse.toLowerCase();

        // Chercher la zone correspondante dans l'adresse
        var zoneTrouvee = null;
        for (var i = 0; i < zones.length; i++) {
            var quartiersZone = zones[i].quartiers.split(',').map(q => q.trim().toLowerCase());
            for (var j = 0; j < quartiersZone.length; j++) {
                if (quartiersZone[j] && adresseLower.includes(quartiersZone[j])) {
                    zoneTrouvee = zones[i];
                    // Mettre le quartier trouvé dans le champ
                    quartierInput.value = quartiersZone[j].charAt(0).toUpperCase() + quartiersZone[j].slice(1);
                    break;
                }
            }
            if (zoneTrouvee) break;
        }

        if (zoneTrouvee) {
            zoneDetectee.style.display = 'block';
            zoneNonTrouvee.style.display = 'none';
            zoneManuelle.style.display = 'none';
            document.getElementById('zoneNom').textContent = zoneTrouvee.nom;
            document.getElementById('zonePrix').textContent = zoneTrouvee.prix.toLocaleString();
            zoneIdDetectee.value = zoneTrouvee.id;
            zoneSelect.value = '';
            fraisLivraison = zoneTrouvee.prix;
        } else {
            zoneDetectee.style.display = 'none';
            zoneNonTrouvee.style.display = 'block';
            zoneManuelle.style.display = 'block';
            zoneIdDetectee.value = '';
            fraisLivraison = 0;
        }
        
        updateTotal();
    }

    function detecterZone() {
        var quartier = document.getElementById('quartierInput').value.toLowerCase().trim();
        var zoneDetectee = document.getElementById('zoneDetectee');
        var zoneNonTrouvee = document.getElementById('zoneNonTrouvee');
        var zoneManuelle = document.getElementById('zoneManuelleSection');
        var zoneIdDetectee = document.getElementById('ZoneIdDetectee');
        var zoneSelect = document.getElementById('ZoneId');

        if (quartier.length < 2) {
            zoneDetectee.style.display = 'none';
            zoneNonTrouvee.style.display = 'none';
            zoneManuelle.style.display = 'none';
            fraisLivraison = 0;
            updateTotal();
            return;
        }

        // Chercher la zone correspondante
        var zoneTrouvee = null;
        for (var i = 0; i < zones.length; i++) {
            var quartiersZone = zones[i].quartiers.split(',').map(q => q.trim().toLowerCase());
            for (var j = 0; j < quartiersZone.length; j++) {
                if (quartiersZone[j].includes(quartier) || quartier.includes(quartiersZone[j])) {
                    zoneTrouvee = zones[i];
                    break;
                }
            }
            if (zoneTrouvee) break;
        }

        if (zoneTrouvee) {
            zoneDetectee.style.display = 'block';
            zoneNonTrouvee.style.display = 'none';
            zoneManuelle.style.display = 'none';
            document.getElementById('zoneNom').textContent = zoneTrouvee.nom;
            document.getElementById('zonePrix').textContent = zoneTrouvee.prix.toLocaleString();
            zoneIdDetectee.value = zoneTrouvee.id;
            zoneSelect.value = ''; // Reset manual selection
            fraisLivraison = zoneTrouvee.prix;
        } else {
            zoneDetectee.style.display = 'none';
            zoneNonTrouvee.style.display = 'block';
            zoneManuelle.style.display = 'block';
            zoneIdDetectee.value = '';
        }
        
        updateTotal();
    }

    function updateFraisManuel() {
        var select = document.getElementById('ZoneId');
        var option = select.options[select.selectedIndex];
        fraisLivraison = option ? parseFloat(option.getAttribute('data-prix')) || 0 : 0;
        updateTotal();
    }

    function updateTotal() {
        document.getElementById('fraisLivraison').textContent = fraisLivraison.toLocaleString() + ' FCFA';
        document.getElementById('totalCommande').textContent = (sousTotal + fraisLivraison).toLocaleString() + ' FCFA';
    }

    function toggleAddressInput() {
        var useExisting = document.getElementById('useExistingAddress');
        var newAddressInput = document.getElementById('newAddressInput');
        var existingDisplay = document.getElementById('existingAddressDisplay');
        var quartierInput = document.getElementById('quartierInput');

        if (useExisting && useExisting.checked) {
            newAddressInput.style.display = 'none';
            if (existingDisplay) existingDisplay.style.display = 'block';
            // Détecter la zone depuis l'adresse enregistrée
            if (adresseEnregistree) {
                detecterZoneDepuisAdresse(adresseEnregistree);
            }
        } else {
            newAddressInput.style.display = 'block';
            if (existingDisplay) existingDisplay.style.display = 'none';
            // Réinitialiser la détection de zone
            quartierInput.value = '';
            document.getElementById('zoneDetectee').style.display = 'none';
            document.getElementById('zoneNonTrouvee').style.display = 'none';
            document.getElementById('zoneManuelleSection').style.display = 'none';
            document.getElementById('ZoneIdDetectee').value = '';
            fraisLivraison = 0;
            updateTotal();
        }
    }
</script>