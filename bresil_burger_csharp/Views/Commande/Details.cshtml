@model Commande
@{
    ViewData["Title"] = $"Commande #{Model.Id}";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="MesCommandes">Mes Commandes</a></li>
            <li class="breadcrumb-item active">Commande #@Model.Id</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Commande #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td class="text-muted">Date :</td>
                            <td>@Model.DateCommande.ToString("dd/MM/yyyy à HH:mm")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Type :</td>
                            <td>
                                @switch (Model.TypeLivraison)
                                {
                                    case "SUR_PLACE":
                                        <span><i class="bi bi-shop me-1"></i> Sur place</span>
                                        break;
                                    case "A_EMPORTER":
                                        <span><i class="bi bi-bag me-1"></i> À emporter</span>
                                        break;
                                    case "LIVRAISON":
                                        <span><i class="bi bi-truck me-1"></i> Livraison - @Model.Zone?.Nom</span>
                                        break;
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Statut :</td>
                            <td>
                                @switch (Model.Etat)
                                {
                                    case "EN_ATTENTE":
                                        <span class="badge bg-warning text-dark">En attente de paiement</span>
                                        break;
                                    case "EN_PREPARATION":
                                        <span class="badge bg-info">En préparation</span>
                                        break;
                                    case "PRETE":
                                        <span class="badge bg-success">Prête</span>
                                        break;
                                    case "TERMINEE":
                                        <span class="badge bg-primary">Terminée</span>
                                        break;
                                    case "ANNULEE":
                                        <span class="badge bg-danger">Annulée</span>
                                        break;
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Total :</td>
                            <td class="fw-bold text-warning fs-5">@Model.MontantTotal.ToString("N0") FCFA</td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (Model.Paiement != null)
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Paiement</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless mb-0">
                            <tr>
                                <td class="text-muted">Mode :</td>
                                <td>
                                    @if (Model.Paiement.ModePaiement == "WAVE")
                                    {
                                        <span><i class="bi bi-phone text-primary me-1"></i> Wave</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-phone text-warning me-1"></i> Orange Money</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Référence :</td>
                                <td><code>@Model.Paiement.Reference</code></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Date :</td>
                                <td>@Model.Paiement.DatePaiement.ToString("dd/MM/yyyy à HH:mm")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-cart me-2"></i>Articles commandés</h5>
                </div>
                <div class="card-body">
                    @if (Model.LignesCommande.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var ligne in Model.LignesCommande)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (ligne.Burger != null)
                                        {
                                            <span class="badge bg-danger me-2">Burger</span>
                                            <strong>@ligne.Burger.Nom</strong>
                                        }
                                        else if (ligne.Menu != null)
                                        {
                                            <span class="badge bg-success me-2">Menu</span>
                                            <strong>@ligne.Menu.Nom</strong>
                                            <small class="text-muted d-block">
                                                @ligne.Menu.Burger?.Nom + @ligne.Menu.Boisson?.Nom + @ligne.Menu.Frite?.Nom
                                            </small>
                                        }
                                        <small class="text-muted">x @ligne.Quantite</small>
                                    </div>
                                    <span class="fw-bold">@((ligne.PrixUnitaire * ligne.Quantite).ToString("N0")) FCFA</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="MesCommandes" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à mes commandes
        </a>
    </div>
</div>