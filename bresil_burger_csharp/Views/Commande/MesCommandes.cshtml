@model List<Commande>
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container">
    <h2 class="my-4"><i class="bi bi-bag-check me-2"></i>Mes Commandes</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover shadow-sm">
                <thead class="table-warning">
                    <tr>
                        <th>N° Commande</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th>Paiement</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var commande in Model)
                    {
                        <tr>
                            <td><strong>#@commande.Id</strong></td>
                            <td>@commande.DateCommande.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @switch (commande.TypeLivraison)
                                {
                                    case "SUR_PLACE":
                                        <span class="badge bg-info"><i class="bi bi-shop me-1"></i> Sur place</span>
                                        break;
                                    case "A_EMPORTER":
                                        <span class="badge bg-secondary"><i class="bi bi-bag me-1"></i> À emporter</span>
                                        break;
                                    case "LIVRAISON":
                                        <span class="badge bg-primary"><i class="bi bi-truck me-1"></i> Livraison</span>
                                        break;
                                }
                            </td>
                            <td class="fw-bold">@commande.MontantTotal.ToString("N0") FCFA</td>
                            <td>
                                @switch (commande.Etat)
                                {
                                    case "EN_ATTENTE":
                                        <span class="badge bg-warning text-dark">En attente</span>
                                        break;
                                    case "EN_PREPARATION":
                                        <span class="badge bg-info">En préparation</span>
                                        break;
                                    case "PRETE":
                                        <span class="badge bg-success">Prête</span>
                                        break;
                                    case "TERMINEE":
                                        <span class="badge bg-primary">Terminée</span>
                                        break;
                                    case "ANNULEE":
                                        <span class="badge bg-danger">Annulée</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@commande.Etat</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (commande.Paiement != null)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i> Payée</span>
                                }
                                else
                                {
                                    <a asp-action="Paiement" asp-route-id="@commande.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-credit-card me-1"></i> Payer
                                    </a>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@commande.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>Détails
                                    </a>
                                    @if (commande.Paiement == null && commande.Etat != "ANNULEE")
                                    {
                                        <form asp-action="Annuler" asp-route-id="@commande.Id" method="post" style="display: inline;" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle me-1"></i>Annuler
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x display-1 text-muted mb-3"></i>
            <h4 class="text-muted mb-4">Vous n'avez pas encore de commandes</h4>
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-warning btn-lg">
                <i class="bi bi-grid me-2"></i> Voir le catalogue
            </a>
        </div>
    }
</div>