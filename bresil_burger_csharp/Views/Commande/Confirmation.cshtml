@model Commande
@{
    ViewData["Title"] = "Commande confirmée";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow mt-4">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success display-1"></i>
                    </div>
                    
                    <h2 class="text-success mb-3">Commande confirmée !</h2>
                    
                    <p class="lead text-muted">
                        Merci pour votre commande. Votre paiement a été effectué avec succès.
                    </p>

                    <div class="card bg-light my-4">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-receipt me-2"></i>Détails de la commande</h5>
                            
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <td class="text-muted">Numéro de commande :</td>
                                    <td class="fw-bold">#@Model.Id</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Date :</td>
                                    <td>@Model.DateCommande.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Mode de service :</td>
                                    <td>
                                        @switch (Model.TypeLivraison)
                                        {
                                            case "SUR_PLACE":
                                                <span><i class="bi bi-shop me-1"></i> Sur place</span>
                                                break;
                                            case "A_EMPORTER":
                                                <span><i class="bi bi-bag me-1"></i> À emporter</span>
                                                break;
                                            case "LIVRAISON":
                                                <span><i class="bi bi-truck me-1"></i> Livraison - @Model.Zone?.Nom</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Montant payé :</td>
                                    <td class="fw-bold text-warning fs-5">@Model.MontantTotal.ToString("N0") FCFA</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Référence paiement :</td>
                                    <td><code>@Model.Paiement?.Reference</code></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Mode de paiement :</td>
                                    <td>
                                        @if (Model.Paiement?.ModePaiement == "WAVE")
                                        {
                                            <span><i class="bi bi-phone text-primary me-1"></i> Wave</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-phone text-warning me-1"></i> Orange Money</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Statut :</td>
                                    <td><span class="badge bg-success">Validée</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    @if (Model.LignesCommande != null && Model.LignesCommande.Any())
                    {
                        <div class="card bg-light my-4">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-list-check me-2"></i>Produits commandés</h5>
                                <div class="list-group list-group-flush">
                                    @foreach (var ligne in Model.LignesCommande)
                                    {
                                        <div class="list-group-item bg-transparent">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>
                                                        @if (ligne.BurgerId.HasValue && ligne.Burger != null)
                                                        {
                                                            <i class="bi bi-egg-fried text-warning me-1"></i>
                                                            @ligne.Burger.Nom
                                                        }
                                                        else if (ligne.MenuId.HasValue && ligne.Menu != null)
                                                        {
                                                            <i class="bi bi-box-seam text-warning me-1"></i>
                                                            @ligne.Menu.Nom
                                                        }
                                                    </strong>
                                                    <small class="text-muted ms-2">x @ligne.Quantite</small>
                                                </div>
                                                <span class="fw-bold">@ligne.SousTotal.ToString("N0") FCFA</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Votre commande est en cours de préparation. Vous recevrez une notification lorsqu'elle sera prête !
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="MesCommandes" class="btn btn-warning">
                            <i class="bi bi-bag-check me-2"></i> Voir mes commandes
                        </a>
                        <a asp-controller="Catalogue" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-grid me-2"></i> Retour au catalogue
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>